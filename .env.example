# ---------------------------------------------------------------------------
# AI providers — you only need ONE. Set a key for whichever you want to use
# and leave the others commented out. Pick the model per task in the app,
# under "AI models".
#
# Leaving a variable assigned but empty (FOO=) counts as "set to empty" and
# shadows the same variable in .env, so comment out what you aren't using
# rather than assigning it an empty value.
# ---------------------------------------------------------------------------

# OpenAI (GPT) — the default provider when a key is present
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5

# Anthropic (Claude) — optional
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Google (Gemini) — optional. GOOGLE_API_KEY also works.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3-pro

# Optional: which provider the defaults are built from when several keys are
# set. Defaults to openai, then anthropic, then google.
# PROVIDER_DEFAULT=openai

DATABASE_URL="file:./dev.db"
