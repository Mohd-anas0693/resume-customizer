# At least one provider key is required for the AI steps.
# Pick which model each task uses in the app, under "AI models".

# Anthropic (Claude) — the default provider
ANTHROPIC_API_KEY=
# Optional: forces one Claude model for every task
ANTHROPIC_MODEL=

# OpenAI (GPT) — optional
OPENAI_API_KEY=
OPENAI_MODEL=

# Google (Gemini) — optional. GOOGLE_API_KEY also works.
GEMINI_API_KEY=
GEMINI_MODEL=

DATABASE_URL="file:./dev.db"
